<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
           id="997af124-8a57-4159-84af-a36ea44f9b2b" name="Дети Сатаны" revision="1" battleScribeVersion="2.03"
           gameSystemId="a1b2c3d4-0000-4000-8000-000000000001" hidden="false" library="false">
  <rules>
    <rule id="a78f3653-d233-4439-853f-9dc42f3da7d6" name="Описание" hidden="false">
      <description>Наёмные стрелки дома Вараздат. Их болты моют не водой.</description>
    </rule>
    <rule id="da7a3413-ef95-4fd4-8dab-9a842b0ab835" name="Освящённые кровью болты" hidden="false">
      <description>Один раз за игру стрельба отряда наносит смертельные раны вместо обычных.</description>
    </rule>
    <rule id="1a25d93c-fcc0-486d-86d6-3033f547db63" name="Стая" hidden="false">
      <description>Отряд может стрелять после отступления.</description>
    </rule>
    <rule id="bebd572b-f1ab-4acc-8775-d50286d5e9b4" name="Описание" hidden="false">
      <description>Молодые клинки Филимаксио, жаждущие первой крови и первых титулов.</description>
    </rule>
    <rule id="fc9400a2-a218-45b9-82c4-b7369ec0f647" name="Жатва" hidden="false">
      <description>За каждую уничтоженную этим отрядом вражескую модель отряд восстанавливает 1 рану.</description>
    </rule>
    <rule id="87748ea8-66c0-4d3e-8b36-537fc37f0419" name="Ритуальный азарт" hidden="false">
      <description>После уничтожения вражеского отряда этот отряд может сразу совершить ещё одно движение.</description>
    </rule>
    <rule id="23df2ce9-83dd-4a41-804a-c08250177606" name="Описание" hidden="false">
      <description>Суд и плаха дома Филимаксио в одних доспехах. Приговор обжалованию не подлежит.</description>
    </rule>
    <rule id="fcd40681-19cb-4984-8069-b9f2aa9aa1d4" name="Приговор" hidden="false">
      <description>В начале боя выберите вражеский отряд: юстициары наносят ему +1 к урону всю игру.</description>
    </rule>
    <rule id="4b6fd660-ac60-484f-8883-c083b016d9a7" name="Плащ палача" hidden="false">
      <description>Отряд имеет инвуль 5+ и не отступает добровольно.</description>
    </rule>
  </rules>
