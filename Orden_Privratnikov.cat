<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
           id="022fc852-68dc-46bb-8f09-433f2500b2a6" name="Орден Привратников" revision="1" battleScribeVersion="2.03"
           gameSystemId="a1b2c3d4-0000-4000-8000-000000000001" hidden="false" library="false">
  <rules>
    <rule id="e3f1459d-2f31-4aa2-895f-3c37ce26bbdc" name="Залп с опорой" hidden="false">
      <description>Если отряд не двигался в этом ходу, его стрельба наносит +1 к урону.</description>
    </rule>
    <rule id="7f8c33bd-b87f-46ee-8a6a-a0cd491c2dba" name="Дозорные Врат" hidden="false">
      <description>Враг не получает бонусов укрытия против стрельбы этого отряда на дистанции до 12&quot;.</description>
    </rule>
    <rule id="973eb3ea-8bfc-4cf8-8bf0-178cef69f5a3" name="Стойкость клятвы" hidden="false">
      <description>Отряд автоматически проходит проверки морали, стоя на цели.</description>
    </rule>
    <rule id="7c7f07c5-7506-488c-8689-047e9fa3efd1" name="Сомкнутый строй" hidden="false">
      <description>Пока в отряде не меньше половины моделей, его спасбросок улучшается до 2+ против дальнего боя.</description>
    </rule>
    <rule id="71c2dd2d-5fd2-49e4-8c0b-dc28f0cfca6e" name="Ломовой удар" hidden="false">
      <description>В ход чарджа этот отряд наносит удары первым.</description>
    </rule>
    <rule id="13eda901-380e-414c-8063-da1be7893c55" name="Непоколебимые" hidden="false">
      <description>Отряд игнорирует первый проваленный спасбросок в каждой фазе.</description>
    </rule>
  </rules>
  <sharedSelectionEntries>
