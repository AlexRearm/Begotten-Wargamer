<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema"
           id="022fc852-68dc-46bb-8f09-433f2500b2a6" name="Орден Привратников" revision="1" battleScribeVersion="2.03"
           gameSystemId="a1b2c3d4-0000-4000-8000-000000000001" hidden="false" library="false">
  <rules>
    <rule id="680655a6-dc3e-43da-803c-a0c9698dc998" name="Выстрел в упор" hidden="false">
      <description>Стреляя по врагу на расстоянии 10&quot; и меньше, получают бонус +1 на попадание и +2 к силе оружия.</description>
    </rule>
    <rule id="215b7aa1-43e5-4d86-8fb0-127395c8de7e" name="Легион Сияния" hidden="false">
      <description>Может пополнять или увеличивать свое количество вне лимита за счет странников той же веры (Сияние).</description>
    </rule>
    <rule id="215b7aa1-43e5-4d86-8fb0-127395c8de7e" name="Легион Сияния" hidden="false">
      <description>Может пополнять или увеличивать свое количество вне лимита за счет странников той же веры (Сияние).</description>
    </rule>
    <rule id="7c7f07c5-7506-488c-8689-047e9fa3efd1" name="Сомкнутый строй" hidden="false">
      <description>Пока в отряде не меньше половины людей, его спасбросок улучшается до 4+.</description>
    </rule>
    <rule id="215b7aa1-43e5-4d86-8fb0-127395c8de7e" name="Легион Сияния" hidden="false">
      <description>Может пополнять или увеличивать свое количество вне лимита за счет странников той же веры (Сияние).</description>
    </rule>
    <rule id="7c7f07c5-7506-488c-8689-047e9fa3efd1" name="Сомкнутый строй" hidden="false">
      <description>Пока в отряде не меньше половины людей, его спасбросок улучшается до 4+.</description>
    </rule>
    <rule id="680655a6-dc3e-43da-803c-a0c9698dc998" name="Выстрел в упор" hidden="false">
      <description>Стреляя по врагу на расстоянии 10&quot; и меньше, получают бонус +1 на попадание и +2 к силе оружия.</description>
    </rule>
    <rule id="215b7aa1-43e5-4d86-8fb0-127395c8de7e" name="Легион Сияния" hidden="false">
      <description>Может пополнять или увеличивать свое количество вне лимита за счет странников той же веры (Сияние).</description>
    </rule>
  </rules>
